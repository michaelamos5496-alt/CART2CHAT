# Supabase
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the client. Used for privileged/admin operations.
SUPABASE_SERVICE_ROLE_KEY=

# The canonical production URL (no trailing slash). Used for metadataBase,
# canonical/OG tags, and the sitemap. Falls back to http://localhost:3000
# in dev, so this is only required in production.
NEXT_PUBLIC_SITE_URL=

# Paystack
# Get these from your Paystack dashboard: https://dashboard.paystack.com/#/settings/developer
# Use test keys (sk_test_/pk_test_) for local dev; only use live keys
# (sk_live_/pk_live_) in production, since live-key test charges move
# real money.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
